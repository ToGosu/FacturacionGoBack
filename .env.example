# Copia este archivo a .env (que está en .gitignore) y ajusta los valores.
# Las contraseñas van vacías a propósito: inventa las tuyas (solo para desarrollo local).
# docker compose se niega a arrancar si falta alguna.

# --- PostgreSQL (una instancia, una base y un usuario por servicio) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5433
DB_PASSWORD_IDENTIDAD=
DB_PASSWORD_PRODUCTOS_INVENTARIO=
DB_PASSWORD_VENTAS=
DB_PASSWORD_NOTIFICACIONES=
DB_PASSWORD_REPORTES=

# --- NATS JetStream ---
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222

# --- SMTP de pruebas (Mailpit) ---
SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
